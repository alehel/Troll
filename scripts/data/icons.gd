		"..ykykyyykykyy..",
		"..yyyyyyyyyyy...",
		"..yffyyyyyffy...",
		"..yykkkkkkkyy...",
		"..yyykdddkyyy...",
		"...yyykkkyyy....",
		"....yyyyyyy.....",
		"................",
		"................",
		"................",
		"................",
	],
}

static var _cache := {}


static func has_icon(id: String) -> bool:
	return ART.has(id) or JAM_COLORS.has(id)


static func get_image(id: String) -> Image:
	var rows: Array = []
	var remap := {}
	if JAM_COLORS.has(id):
		rows = ART["jar"]
		remap = JAM_COLORS[id]
	elif ART.has(id):
		rows = ART[id]
	else:
		rows = ART["bag"]
	var img := Image.create(16, 16, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in range(min(16, rows.size())):
		var row: String = rows[y]
		for x in range(min(16, row.length())):
			var ch := row[x]
			if remap.has(ch):
				ch = remap[ch]
			if ch == "." or not PALETTE.has(ch):
				continue
			img.set_pixel(x, y, Color(PALETTE[ch]))
	# automatic outline (4-neighbourhood)
	var outline := Image.create(16, 16, false, Image.FORMAT_RGBA8)
	outline.copy_from(img)
	for y in range(16):
		for x in range(16):
			if img.get_pixel(x, y).a > 0.0:
				continue
			var near := false
			for o in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
				var p: Vector2i = Vector2i(x, y) + o
				if p.x >= 0 and p.y >= 0 and p.x < 16 and p.y < 16 and img.get_pixel(p.x, p.y).a > 0.0:
					near = true
					break
			if near:
				outline.set_pixel(x, y, OUTLINE)
	return outline


static func get_texture(id: String) -> Texture2D:
	if _cache.has(id):
		return _cache[id]
	var tex := ImageTexture.create_from_image(get_image(id))
	_cache[id] = tex
	return tex
